---
import { siteConfig } from '../data/siteConfig';

export interface Props {
  title: string;
  description: string;
  lang: 'en' | 'fa';
}

const { title, description, lang } = Astro.props;

const currentPath = Astro.url.pathname;
const enUrl = new URL(currentPath.replace(/^\/(fa|en)/, '/en'), 'https://sobhannami.com').href;
const faUrl = new URL(currentPath.replace(/^\/(fa|en)/, '/fa'), 'https://sobhannami.com').href;

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://sobhannami.com/#person',
      name: lang === 'fa' ? siteConfig.fa.name : siteConfig.en.name,
      alternateName: lang === 'fa' ? siteConfig.en.name : siteConfig.fa.name,
      jobTitle: lang === 'fa' ? siteConfig.fa.role : siteConfig.en.role,
      worksFor: {
        '@type': 'Organization',
        name: 'Ronika Pars (Ertebat Sanat Ronika Pars)',
        url: 'https://ronikapars.com'
      },
      alumniOf: [
        {
          '@type': 'CollegeOrUniversity',
          name: 'Shiraz University',
          department: 'Secure Computing'
        },
        {
          '@type': 'CollegeOrUniversity',
          name: 'Persian Gulf University',
          department: 'Software Engineering'
        }
      ],
      sameAs: [
        siteConfig.linkedin,
        siteConfig.telegram,
        'https://ieeexplore.ieee.org'
      ],
      knowsAbout: [
        'Software Architecture',
        'Distributed Systems',
        'Internet of Things',
        'Secure Computing',
        'Cloud Infrastructure'
      ],
      description: lang === 'fa' ? siteConfig.fa.intro : siteConfig.en.intro,
      email: `mailto:${siteConfig.email}`
    },
    {
      '@type': 'WebSite',
      '@id': 'https://sobhannami.com/#website',
      url: 'https://sobhannami.com',
      name: 'Sobhan Nami',
      inLanguage: ['en', 'fa']
    }
  ]
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={Astro.url.href} />

<!-- Bilingual Alternates -->
<link rel="alternate" hreflang="fa" href={faUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={faUrl} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />

<!-- Twitter -->
<meta property="twitter:card" content="summary" />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
